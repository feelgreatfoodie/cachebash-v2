rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users own their data — each user's subcollections are private
    // This multi-tenant isolation ensures agents can't access each other's task queues,
    // sessions, or message relays. Authentication is required for all reads/writes.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // API keys are read-only for authenticated users (writes via Admin SDK only)
    // Keys are stored top-level for efficient hash-based lookup during authentication.
    // Clients can verify their own keys, but only the server can create/revoke them.
    match /apiKeys/{hash} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default deny — explicit access only
    // Security-by-default: any collection not explicitly allowed above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
