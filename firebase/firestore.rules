rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Devices subcollection
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Interrupts subcollection (messages from app to Claude)
        match /interrupts/{interruptId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Questions subcollection
      match /questions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Projects subcollection
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Analytics subcollection
      match /analytics/{period} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Analytics are written by Cloud Functions only
        allow write: if false;
      }
    }

    // API key lookup - allows app to manage keys, MCP server uses service account
    match /apiKeys/{keyHash} {
      // Users can read/delete their own API key entries
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      // Users can create/update their own API key entries
      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
